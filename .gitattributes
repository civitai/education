# Large media lives in Git LFS. The image build cannot fetch LFS objects, so .dockerignore keeps these
# out of the image and nginx serves them from the B2 copy.
public/videos/** filter=lfs diff=lfs merge=lfs -text
public/wp-content/uploads/2023/08/JJBinksColab.zip filter=lfs diff=lfs merge=lfs -text
