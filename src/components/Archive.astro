---
// A paginated list of posts: the posts page, categories, tags, authors and /page/N/.
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from './PostList.astro';
import Pagination from './Pagination.astro';
import { pageCount, paginate, type Post } from '../lib/content';

interface Props {
  title: string;
  /** Visible heading; defaults to title. */
  heading?: string;
  description?: string;
  base: string;
  page: number;
  posts: Post[];
  feed?: string;
}
const { title, heading = title, description, base, page, posts, feed } = Astro.props;
const total = pageCount(posts.length);
const path = page === 1 ? base : `${base}page/${page}/`;
const pageTitle = page === 1 ? title : `${title} - Page ${page} of ${total}`;
const currentCategory = base.match(/^\/category\/([^/]+)\/$/)?.[1];
---

<BaseLayout title={pageTitle} description={description} path={path} feed={feed} currentCategory={currentCategory}>
  <div class="archive">
    <header class="archive-header">
      <h1>{heading}</h1>
      {description && <p class="archive-description">{description}</p>}
    </header>
    <PostList posts={paginate(posts, page)} />
    <Pagination base={base} current={page} total={total} />
  </div>
</BaseLayout>
