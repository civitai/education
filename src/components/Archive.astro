---
// A paginated list of posts: the posts page, categories, tags, authors and /page/N/.
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryChips from './CategoryChips.astro';
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';
import { pageCount, paginate, type Post } from '../lib/content';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  /** Visible heading; defaults to title. */
  heading?: string;
  /**
   * Prefixes the current crumb ("Tag: LoRA") where the name alone would not say what the listing
   * is. Topics and the all-guides list leave it out: their name is the place.
   */
  kind?: string;
  description?: string;
  base: string;
  page: number;
  posts: Post[];
  feed?: string;
}
const { title, heading = title, kind, description, base, page, posts, feed } = Astro.props;
const total = pageCount(posts.length);
const path = page === 1 ? base : `${base}page/${page}/`;
const pageTitle = page === 1 ? title : `${title} - Page ${page} of ${total}`;
const isCategory = base.startsWith('/category/');
const count = `${posts.length} ${posts.length === 1 ? 'guide' : 'guides'}`;
const crumb = kind ? `${kind}: ${heading}` : heading;
// An archive whose posts are all deprecated keeps its URL but lists nothing; search engines skip it.
// /page/N/ continues the front page's listing; its first page is the posts page.
const firstPage = base === '/' ? `/${SITE.postsPageSlug}/` : base;
---

<BaseLayout title={pageTitle} description={description} path={path} feed={feed} noindex={posts.length === 0}>
  <div class="archive">
    {isCategory && <CategoryChips class="home-chips" />}
    <header class="archive-head">
      <p class="crumbs">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        {
          page === 1 ? (
            <span aria-current="page">{crumb}</span>
          ) : (
            <>
              <a href={firstPage}>{crumb}</a>
              <span aria-hidden="true">/</span>
              <span aria-current="page">Page {page}</span>
            </>
          )
        }
      </p>
      <h1 class="archive-title">{heading}</h1>
      {description && <p class="archive-desc">{description}</p>}
      <p class="archive-count">
        {count}
        {total > 1 && <span>· Page {page} of {total}</span>}
      </p>
    </header>
    {
      posts.length === 0 && (
        <p class="archive-empty">
          The guides here are out of date and no longer listed. <a href="/">Browse current guides</a> or <a href="/search/">search</a>.
        </p>
      )
    }
    <ul class="story-grid archive-grid">
      {
        paginate(posts, page).map((post, i) => (
          <li>
            <PostCard post={post} level={2} eager={i < 3} />
          </li>
        ))
      }
    </ul>
    <Pagination base={base} current={page} total={total} />
  </div>
</BaseLayout>
