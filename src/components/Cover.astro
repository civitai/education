---
// A post cover in a fixed frame. Covers are 16:9 with the subject centred, so the square frame
// crops from the centre, and so does the wide frame on cards, while the lead story and the
// article cover (base.css) drop the frame's ratio and show the whole image at its own shape.
interface Props {
  src: string;
  /** Square thumbnail (pass coverOf) or a wide, cropped frame (pass the original image). */
  shape?: 'square' | 'wide';
  /** Empty by default: covers sit next to the post title, which already names the link. */
  alt?: string;
  /** Load at once (above the fold) instead of lazily. */
  eager?: boolean;
  /** Fetch first: the one image that is the page's largest paint. */
  priority?: boolean;
  class?: string;
}
const { src, shape = 'square', alt = '', eager = false, priority = false, class: className } = Astro.props;
// Intrinsic size hints for layout before load; the frame's own aspect ratio wins.
const [width, height] = shape === 'wide' ? [1280, 720] : [640, 640];
---

<span class:list={['cover', { wide: shape === 'wide' }, className]} style={`--cover: url("${src}")`}>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager || priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
  />
</span>
