---
// The way back to civitai.com beside an article: the page's one Pro-gradient action.
import Icon from './icons/Icon.astro';
---

<section class="follow" aria-labelledby="follow-heading" data-pagefind-ignore>
  <h2 class="follow-label" id="follow-heading">Follow along</h2>
  <p class="follow-text">Open Civitai in another tab and do each step as you read.</p>
  <a class="btn-pro follow-btn" href="https://civitai.com" target="_blank" rel="noopener">
    Try it on Civitai
    <Icon name="external-link" size={16} />
    <span class="sr-only">(opens in a new tab)</span>
  </a>
</section>
