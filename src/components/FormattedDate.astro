---
interface Props {
  date: Date;
  /** MM/DD/YYYY instead of "October 6, 2023". */
  numeric?: boolean;
}
const { date, numeric = false } = Astro.props;
const label = numeric
  ? date.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'UTC' })
  : date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<time datetime={date.toISOString()}>{label}</time>
