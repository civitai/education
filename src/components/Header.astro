---
import CategoryChips from './CategoryChips.astro';
import MobileMenu from './MobileMenu.astro';
import Icon from './icons/Icon.astro';
import Logo from './Logo.astro';
---

<header class="site-header">
  <div class="hdr-bar">
    <a class="brand" href="/">
      <Logo class="brand-mark" />
      <span class="brand-sub">Education</span>
    </a>
    <CategoryChips class="hdr-chips" />
    <span class="spacer"></span>
    <form class="top-search hdr-search" action="/search/" role="search" data-top-search>
      <label class="search-field">
        <Icon name="search" size={16} />
        <input type="search" name="q" placeholder="Search guides" aria-label="Search guides" autocomplete="off" />
        <kbd title="Press / to search">/</kbd>
      </label>
      <div class="top-results" hidden></div>
    </form>
    <a class="icon-btn hdr-phone search-btn" href="/search/" aria-label="Search" data-search-open>
      <Icon name="search" size={20} />
    </a>
    <button class="icon-btn theme-btn" type="button" aria-label="Switch color theme" data-theme-toggle>
      <Icon name="moon" class="i-moon" size={18} />
      <Icon name="sun" class="i-sun" size={18} />
    </button>
    <a class="icon-btn hdr-phone menu-btn" href="#site-menu" aria-label="Menu" data-menu-fallback>
      <Icon name="menu" size={20} />
    </a>
    <button
      class="icon-btn hdr-phone menu-btn"
      type="button"
      aria-label="Open menu"
      aria-controls="site-menu"
      aria-expanded="false"
      hidden
      data-menu-toggle
    >
      <Icon name="menu" class="i-menu" size={20} />
      <Icon name="x" class="i-close" size={20} />
    </button>
  </div>
  <MobileMenu />
</header>

<script>
  const root = document.documentElement;

  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Private mode: the choice just lasts for this page.
    }
  });

  // Phone menu: a sheet under the header. Focus stays inside the header while it is open, Escape
  // or the X closes it and focus goes back to the button that opened it.
  const header = document.querySelector<HTMLElement>('.site-header');
  const menu = document.getElementById('site-menu');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menuInput = menu?.querySelector('input');
  let opener: HTMLElement | null = null;
  const isOpen = () => root.hasAttribute('data-menu-open');
  const setMenu = (open: boolean, focus?: HTMLElement | null) => {
    if (!toggle || !menu || open === isOpen()) return;
    root.toggleAttribute('data-menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (open) {
      opener = document.activeElement as HTMLElement | null;
      (focus || menu).focus();
    } else {
      (opener && opener.isConnected && opener.offsetParent ? opener : toggle).focus();
    }
  };
  if (toggle && menu) {
    document.querySelector('[data-menu-fallback]')?.remove();
    toggle.hidden = false;
    // From here the script owns the sheet: the no-JS :target rule stops applying, and a page
    // loaded at #site-menu (the fallback link) opens through the script so the X can close it.
    root.classList.add('menu-js');
    if (location.hash === '#site-menu') {
      history.replaceState(history.state, '', location.pathname + location.search);
      if (matchMedia('(max-width: 1023px)').matches) setMenu(true);
    }
    toggle.addEventListener('click', () => setMenu(!isOpen()));
    document.querySelector('[data-search-open]')?.addEventListener('click', (e) => {
      e.preventDefault();
      setMenu(true, menuInput);
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setMenu(false);
    });
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) setMenu(false);
    });
    header?.addEventListener('keydown', (e) => {
      if (!isOpen() || e.key !== 'Tab') return;
      const items = [...header.querySelectorAll<HTMLElement>('a[href], button, input')].filter(
        (el) => !el.hidden && el.offsetParent !== null,
      );
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setMenu(false);
      return;
    }
    // "/" jumps to search from anywhere outside a text field.
    const target = e.target as HTMLElement;
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey || target.closest('input, textarea, select, [contenteditable]'))
      return;
    const desktop = document.querySelector<HTMLInputElement>('.hdr-search input');
    if (desktop && desktop.offsetParent !== null) {
      e.preventDefault();
      desktop.focus();
    } else if (toggle && menuInput) {
      e.preventDefault();
      setMenu(true, menuInput);
    }
  });

  // Search as you type from any page: the top results drop down under the box, and Enter opens the
  // full results page. Pagefind loads on first focus; without JavaScript the form still submits.
  type PagefindData = { url: string; excerpt: string; meta: { title?: string } };
  type PagefindResult = { data: () => Promise<PagefindData> };
  type Pagefind = { search: (q: string) => Promise<{ results: PagefindResult[] }> };
  let pagefind: Promise<Pagefind> | undefined;
  const load = () => {
    const url = '/pagefind/pagefind.js';
    return (pagefind ??= import(/* @vite-ignore */ url));
  };
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-top-search]')) {
    const input = form.querySelector('input');
    const panel = form.querySelector<HTMLElement>('.top-results');
    if (!input || !panel) continue;
    const close = () => (panel.hidden = true);
    let seq = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const run = async () => {
      const q = input.value.trim();
      const mine = ++seq;
      if (!q) return close();
      const { results } = await (await load()).search(q);
      const top = await Promise.all(results.slice(0, 6).map((r: PagefindResult) => r.data()));
      if (mine !== seq) return;
      panel.replaceChildren();
      for (const r of top) {
        const a = document.createElement('a');
        a.href = r.url;
        const t = document.createElement('b');
        t.textContent = r.meta.title || r.url;
        const s = document.createElement('span');
        s.innerHTML = r.excerpt; // Pagefind's own excerpt: escaped page text plus <mark>.
        a.append(t, s);
        panel.append(a);
      }
      const all = document.createElement('a');
      all.className = 'top-all';
      all.href = `/search/?q=${encodeURIComponent(q)}`;
      all.textContent = results.length ? `All ${results.length} results →` : `No matches for “${q}”`;
      panel.append(all);
      panel.hidden = false;
    };
    input.addEventListener('focus', () => void load(), { once: true });
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(run, 120);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        e.stopPropagation();
        close();
      }
    });
    document.addEventListener('click', (e) => {
      if (!form.contains(e.target as Node)) close();
    });
  }
</script>
