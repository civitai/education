---
import { NAV, SITE } from '../lib/site';

interface Props {
  /** The page has the category sidebar, so the phone menu button is shown. */
  sidebar?: boolean;
}
const { sidebar = true } = Astro.props;
const current = Astro.url.pathname;
// Categories live in the sidebar; the top bar keeps the site-level links.
const links = NAV.filter((n) => !n.href.startsWith('/category/') && n.href !== '/' && n.href !== '/search/');
---

<header class="site-header">
  {
    sidebar && (
      <button class="icon-btn nav-btn" type="button" aria-controls="side" aria-expanded="false" data-nav-toggle>
        Menu
      </button>
    )
  }
  <a class="brand" href="/">{SITE.title}</a>
  <ul class="top-nav">
    {
      links.map((item) => (
        <li>
          <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
  <span class="spacer"></span>
  <form class="top-search" action="/search/" role="search" data-top-search>
    <input type="search" name="q" placeholder="Search guides" aria-label="Search guides" autocomplete="off" />
    <div class="top-results" hidden></div>
  </form>
  <a class="icon-btn" href="/search/" aria-label="Search" data-search-icon>Search</a>
  <button class="icon-btn theme-btn" type="button" aria-label="Switch color theme" data-theme-toggle>
    <svg class="i-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
    <svg class="i-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
  </button>
</header>

<script>
  const root = document.documentElement;

  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Private mode: the choice just lasts for this page.
    }
  });

  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const setOpen = (open: boolean) => {
    root.toggleAttribute('data-nav-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', () => setOpen(!root.hasAttribute('data-nav-open')));
  document.querySelector('[data-nav-close]')?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  document.querySelector('.side')?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });

  // Search as you type from any page: the top results drop down under the box, and Enter opens the
  // full results page. Pagefind loads on first focus; without JavaScript the form still submits.
  type PagefindResult = { data: () => Promise<{ url: string; excerpt: string; meta: { title?: string } }> };
  type Pagefind = { search: (q: string) => Promise<{ results: PagefindResult[] }> };
  const form = document.querySelector<HTMLFormElement>('[data-top-search]');
  const input = form?.querySelector('input');
  const panel = form?.querySelector<HTMLElement>('.top-results');
  if (form && input && panel) {
    let pagefind: Promise<Pagefind> | undefined;
    const load = () => {
      const url = '/pagefind/pagefind.js';
      return (pagefind ??= import(/* @vite-ignore */ url));
    };
    const close = () => (panel.hidden = true);
    let seq = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const run = async () => {
      const q = input.value.trim();
      const mine = ++seq;
      if (!q) return close();
      const { results } = await (await load()).search(q);
      const top = await Promise.all(results.slice(0, 6).map((r) => r.data()));
      if (mine !== seq) return;
      panel.replaceChildren();
      for (const r of top) {
        const a = document.createElement('a');
        a.href = r.url;
        const t = document.createElement('b');
        t.textContent = r.meta.title || r.url;
        const s = document.createElement('span');
        s.innerHTML = r.excerpt; // Pagefind's own excerpt: escaped page text plus <mark>.
        a.append(t, s);
        panel.append(a);
      }
      const all = document.createElement('a');
      all.className = 'top-all';
      all.href = `/search/?q=${encodeURIComponent(q)}`;
      all.textContent = results.length ? `All ${results.length} results →` : `No matches for “${q}”`;
      panel.append(all);
      panel.hidden = false;
    };
    input.addEventListener('focus', () => void load(), { once: true });
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(run, 120);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    document.addEventListener('click', (e) => {
      if (!form.contains(e.target as Node)) close();
    });
  }
</script>
