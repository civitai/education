---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  /** "aside" is the sticky rail (slot="aside" of BaseLayout); "inline" is the collapsible block shown above the article on narrow screens. */
  variant?: 'aside' | 'inline';
}
const { headings, variant = 'aside' } = Astro.props;

// Same depth as the WordPress table of contents (h2 and h3), numbered 1, 1.1 to match the section
// numbers prose.css draws on the headings.
let section = 0;
let sub = 0;
const items = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => {
    if (h.depth === 2) {
      section += 1;
      sub = 0;
      return { ...h, num: String(section) };
    }
    sub += 1;
    return { ...h, num: `${section}.${sub}` };
  });
---

{
  items.length >= 3 && (
    <Fragment>
      {variant === 'inline' ? (
        <details class="toc-m" data-pagefind-ignore>
          <summary>On this page</summary>
          <nav aria-label="On this page (inline)">
            <ul>
              {items.map((h) => (
                <li class={`depth-${h.depth}`}>
                  <a href={`#${h.slug}`} data-toc-link>
                    <span class="num">{h.num}</span>
                    <span>{h.text}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      ) : (
        <nav class="toc" aria-label="On this page" data-pagefind-ignore>
          <h2 class="toc-heading">On this page</h2>
          <ul>
            {items.map((h) => (
              <li class={`depth-${h.depth}`}>
                <a href={`#${h.slug}`} data-toc-link>
                  <span class="num">{h.num}</span>
                  <span>{h.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </Fragment>
  )
}

<script>
  // Highlight the section being read, in both the rail and the inline block.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const heads = [...new Set(links.map((a) => a.getAttribute('href')!.slice(1)))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => Boolean(el));
  if (heads.length) {
    let frame = 0;
    const update = () => {
      const line = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--top-h')) + 40;
      let current = heads[0];
      for (const h of heads) {
        if (h.getBoundingClientRect().top <= line) current = h;
        else break;
      }
      for (const a of links) a.classList.toggle('active', a.getAttribute('href') === `#${current.id}`);
    };
    update();
    addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
  }
</script>
