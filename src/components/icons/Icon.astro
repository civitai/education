---
/** Inline stroke icons (lucide shapes), so the chrome needs no icon font or library. */
interface Props {
  name:
    | 'search'
    | 'moon'
    | 'sun'
    | 'menu'
    | 'x'
    | 'external-link'
    | 'arrow-right'
    | 'arrow-up-right'
    | 'chevron-left'
    | 'chevron-right'
    | 'chevron-down'
    | 'list'
    | 'bookmark'
    | 'check'
    | 'alert-triangle';
  size?: number;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;

const PATHS: Record<Props['name'], string> = {
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  moon: '<path stroke-width="1.75" d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  // Drawn for the 18px theme toggle: longer, evenly spaced rays and a lighter stroke so they read
  // as rays rather than dots at small sizes.
  sun: '<g stroke-width="1.75"><circle cx="12" cy="12" r="3.6"/><path d="M18.6 12h2.8M16.67 16.67l1.98 1.98M12 18.6v2.8M7.33 16.67l-1.98 1.98M5.4 12H2.6M7.33 7.33 5.35 5.35M12 5.4V2.6M16.67 7.33l1.98-1.98"/></g>',
  menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
  x: '<path d="M18 6 6 18M6 6l12 12"/>',
  'external-link': '<path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>',
  'arrow-right': '<path d="M5 12h14m-7-7 7 7-7 7"/>',
  'arrow-up-right': '<path d="M7 17 17 7M7 7h10v10"/>',
  'chevron-left': '<path d="m15 18-6-6 6-6"/>',
  'chevron-right': '<path d="m9 18 6-6-6-6"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  list: '<path d="M3 6h.01M3 12h.01M3 18h.01M8 6h13M8 12h13M8 18h13"/>',
  bookmark: '<path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  'alert-triangle': '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01"/>',
};
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={PATHS[name]}
/>
