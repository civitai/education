---
// Posts and pages share the root, exactly as in WordPress: /<slug>/.
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import TableOfContents from '../components/TableOfContents.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getSlugEntries, termName } from '../lib/content';
import { entryDeck, primaryCategory, readingMinutes } from '../lib/nav';
import taxonomies from '../data/taxonomies.json';

export async function getStaticPaths() {
  const entries = await getSlugEntries();
  return entries.map((e) => ({ params: { slug: e.slug }, props: e }));
}

const { post, page } = Astro.props;
const entry = (post || page)!;
const { Content, headings } = await render(entry);
const data = entry.data;
const author = post ? taxonomies.authors.find((a) => a.slug === post.data.author) : undefined;
const modified = data.modified && data.date && data.modified.getTime() > data.date.getTime() ? data.modified : undefined;
const category = post ? primaryCategory(post) : undefined;
const minutes = post ? readingMinutes(entry.body) : 0;
const deck = post ? entryDeck(post.data.excerpt, entry.body) : undefined;
---

<BaseLayout
  title={data.title}
  documentTitle={data.seo?.title}
  description={data.seo?.description || data.excerpt}
  image={data.seo?.ogImage || (post ? post.data.image : undefined)}
  type={post ? 'article' : 'website'}
  published={post ? post.data.date : undefined}
  modified={post ? modified : undefined}
  currentPost={post?.id}
>
  <article class="entry" data-pagefind-body>
    <header class="entry-header">
      {
        post && category && (
          <p class="crumbs" data-pagefind-ignore>
            <a href="/">Home</a>
            <span>/</span>
            <a href={`/category/${category}/`}>{termName('categories', category)}</a>
          </p>
        )
      }
      <h1 class="entry-title" data-pagefind-meta="title" data-pagefind-ignore>{data.title}</h1>
      {deck && <p class="entry-deck">{deck}</p>}
      {
        post && (
          <dl class="entry-kv" data-pagefind-ignore>
            <div>
              <dt>Category</dt>
              <dd>{category ? <a href={`/category/${category}/`}>{termName('categories', category)}</a> : '-'}</dd>
            </div>
            <div>
              <dt>Published</dt>
              <dd><FormattedDate date={post.data.date} numeric /></dd>
            </div>
            <div>
              <dt>{modified ? 'Updated' : 'Author'}</dt>
              <dd>
                {modified ? (
                  <FormattedDate date={modified} numeric />
                ) : author ? (
                  <a href={`/author/${author.slug}/`} rel="author">{author.name}</a>
                ) : (
                  '-'
                )}
              </dd>
            </div>
            <div>
              <dt>Read time</dt>
              <dd>{minutes} min</dd>
            </div>
          </dl>
        )
      }
    </header>
    {post && <TableOfContents headings={headings} variant="inline" />}
    <Prose searchable={false} numbered={Boolean(post)}>
      <Content />
    </Prose>
    {
      post && post.data.tags.length > 0 && (
        <footer class="entry-footer">
          <h2 class="entry-tags-heading">Tags</h2>
          <ul class="entry-tags">
            {post.data.tags.map((t) => (
              <li>
                <a href={`/tag/${t}/`} rel="tag">
                  {termName('tags', t)}
                </a>
              </li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>
  {post && <TableOfContents slot="aside" headings={headings} />}
</BaseLayout>
