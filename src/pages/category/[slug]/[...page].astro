---
// /category/<slug>/ and /category/<slug>/page/N/. A page past the listed posts (see archive()) redirects to the first.
import Archive from '../../../components/Archive.astro';
import { archive, getCategories, getPosts } from '../../../lib/content';

export async function getStaticPaths() {
  const all = await getPosts();
  return (await getCategories()).flatMap((term) => {
    const { posts, extra, last } = archive(all.filter((p) => p.data.categories.includes(term.slug)));
    return [
      { params: { slug: term.slug, page: undefined }, props: { term, posts, page: 1, last } },
      ...extra.map((n) => ({ params: { slug: term.slug, page: `page/${n}` }, props: { term, posts, page: n, last } })),
    ];
  });
}

const { term, posts, page, last } = Astro.props;
const base = `/category/${term.slug}/`;
if (page > last) return Astro.redirect(base);
---

<Archive title={`${term.name} Archives`} heading={term.name} description={term.description} base={base} page={page} posts={posts} feed={`${base}feed/`} />
