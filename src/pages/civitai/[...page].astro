---
// The WordPress "posts page" (/civitai/, see SITE.postsPageSlug): every post, newest first.
// Routes: /civitai/ and /civitai/page/N/.
import Archive from '../../components/Archive.astro';
import { SITE } from '../../lib/site';
import { extraPages, getPage, getPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const page = await getPage(SITE.postsPageSlug);
  const title = page?.data.title || 'All posts';
  return [
    { params: { page: undefined }, props: { page: 1, posts, title } },
    ...extraPages(posts.length).map((n) => ({ params: { page: `page/${n}` }, props: { page: n, posts, title } })),
  ];
}

const { page, posts, title } = Astro.props;
---

<Archive title={title} heading="Every guide" kind="All guides" base={`/${SITE.postsPageSlug}/`} page={page} posts={posts} feed="/feed/" />
