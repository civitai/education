---
// The front page, laid out as an issue of the journal. WordPress used an Elementor page here
// (src/content/pages/home.md keeps its content and SEO fields); the site generates the listing
// itself: the newest post as the lead story, a start-here path, the latest posts, the topics, a
// glossary teaser and the way back to civitai.com.
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryChips from '../components/CategoryChips.astro';
import Cover from '../components/Cover.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/icons/Icon.astro';
import taxonomies from '../data/taxonomies.json';
import { SITE } from '../lib/site';
import { coverOf, getPage, getPosts, postPath, termName } from '../lib/content';
import { START_HERE, entryDeck, getHomeTopics, getLeadPost, primaryCategory, readingMinutes } from '../lib/nav';

const home = await getPage(SITE.frontPageSlug);
const posts = await getPosts();
const lead = await getLeadPost();
const latest = posts.filter((p) => p !== lead).slice(0, 6);
const start = START_HERE.map((slug) => posts.find((p) => p.id === slug)).filter((p) => p !== undefined);
const topics = await getHomeTopics();

const leadCategory = lead && primaryCategory(lead);
const leadAuthor = lead && (taxonomies.authors.find((a) => a.slug === lead.data.author)?.name || lead.data.author);
const leadDeck = lead && entryDeck(lead.data.excerpt, lead.body);
const leadMinutes = lead ? readingMinutes(lead.body) : 0;

// The series titles repeat "Using Civitai –"; the steps read better as the tool's name.
const stepTitle = (title: string) => title.replace(/^Using Civitai\s+[–-]\s+(?=The )/, '');

// Plain-language definitions for the terms beginners hit first; the glossary post has the rest.
const GLOSSARY_PATH = '/generative-ai-glossary/';
const TERMS = [
  { term: 'LoRA', text: 'A small add-on file that teaches a model one style, character or concept.' },
  { term: 'Checkpoint', text: 'The full base model that every image starts from.' },
  { term: 'CFG scale', text: 'How strictly the image follows your prompt.' },
  { term: 'Sampler', text: 'The method that turns noise into an image, step by step.' },
];
---

<BaseLayout
  title={SITE.title}
  documentTitle={home?.data.seo?.title}
  description={home?.data.seo?.description || home?.data.excerpt || SITE.description}
  image={home?.data.seo?.ogImage}
  path="/"
  sidebar={false}
>
  <div class="home">
    <h1 class="sr-only">{SITE.title}</h1>
    <CategoryChips class="home-chips" />

    {
      lead && (
        <section class="lead" aria-labelledby="lead-title">
          {lead.data.image && (
            <a class="lead-cover" href={postPath(lead)} tabindex="-1" aria-hidden="true">
              <Cover src={lead.data.image} shape="wide" priority />
            </a>
          )}
          <div class="lead-copy">
            <p class="lead-crumb">
              {leadCategory && (
                <>
                  <a href={`/category/${leadCategory}/`}>{termName('categories', leadCategory)}</a>
                  <span aria-hidden="true">/</span>
                </>
              )}
              <span>Featured guide</span>
            </p>
            <h2 class="lead-title" id="lead-title">
              <a href={postPath(lead)}>{lead.data.title}</a>
            </h2>
            {leadDeck && <p class="lead-deck">{leadDeck}</p>}
            <p class="byline">
              <span>{leadAuthor}</span>
              <span aria-hidden="true">·</span>
              <FormattedDate date={lead.data.date} />
              <span aria-hidden="true">·</span>
              <span>{leadMinutes} min read</span>
            </p>
            <a class="btn" href={postPath(lead)}>
              Read the guide
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </section>
      )
    }

    {
      start.length > 0 && (
        <section class="start" aria-labelledby="start-here">
          <div class="section-head">
            <div>
              <h2 id="start-here">
                <span class="wide-only">New here? Start with these three</span>
                <span class="phone-only">Start here</span>
              </h2>
              <p class="section-sub wide-only">The path most people take from first visit to first trained LoRA.</p>
            </div>
            <a class="more" href="/category/beginner-guides/">
              <span class="wide-only">All beginner guides</span>
              <span class="phone-only">All</span>
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
          <ol class="steps">
            {start.map((p, i) => {
              const deck = entryDeck(p.data.excerpt, p.body);
              return (
                <li>
                  <a class="step" href={postPath(p)}>
                    {coverOf(p) && <Cover src={coverOf(p)!} />}
                    <span class="step-body">
                      <span class="step-meta">
                        STEP {String(i + 1).padStart(2, '0')} · {readingMinutes(p.body)} min
                      </span>
                      <span class="step-title">{stepTitle(p.data.title)}</span>
                      {deck && <span class="step-deck">{deck}</span>}
                    </span>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      )
    }

    <section class="latest" aria-labelledby="latest">
      <div class="section-head ruled">
        <h2 id="latest">Latest</h2>
        <a class="more" href={`/${SITE.postsPageSlug}/`}>
          Everything
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
      <ul class="story-grid">
        {
          latest.map((p) => (
            <li>
              <PostCard post={p} />
            </li>
          ))
        }
      </ul>
    </section>

    <div class="home-band">
      <section class="topics" aria-labelledby="topics">
        <h2 id="topics">Browse by topic</h2>
        <ul class="topic-list">
          {
            topics.map((t) => (
              <li>
                <a href={t.href}>
                  <span class="topic-name">{t.name}</span>
                  {t.description && <span class="topic-desc">{t.description}</span>}
                  <span class="topic-count">
                    {t.count}
                    <span class="sr-only"> posts</span>
                  </span>
                  <Icon name="arrow-up-right" size={16} class="wide-only" />
                  <Icon name="chevron-right" size={16} class="phone-only" />
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="glossary" aria-labelledby="glossary">
        <h2 id="glossary">Hit a word you don't know?</h2>
        <dl>
          {
            TERMS.map((t) => (
              <div>
                <dt>{t.term}</dt>
                <dd>{t.text}</dd>
              </div>
            ))
          }
        </dl>
        <a class="more" href={GLOSSARY_PATH}>
          Open the glossary
          <Icon name="arrow-right" size={14} />
        </a>
      </section>
    </div>

    <section class="try" aria-labelledby="try">
      <div>
        <h2 id="try">Read it, then make it.</h2>
        <p>Every guide here works with the generator and trainer on civitai.com.</p>
      </div>
      <a class="btn-pro" href="https://civitai.com/">
        Try it on Civitai
        <Icon name="external-link" size={16} />
      </a>
    </section>
  </div>
</BaseLayout>
